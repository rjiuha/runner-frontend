{
  "name": "runner-game",
  "displayName": "Star Runners",
  "expo": {
    "slug": "runner-game",
    "name": "Star Runners",
    "description": "Рейс на выживание",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "splash": {
  
      "image": "./src/assets/images/icon.png",
