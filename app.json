    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.runnergame.app"
    },
    "android": {
      "package": "com.runnergame.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/foreground.png",
        "backgroundColor": "#2c3e50"
      }
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    }
  }
}
